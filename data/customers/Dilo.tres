intro_lines = Array[String](["Greetings. Charming little establishment you run here.", "I'm told the... clientele here is very tender. Well-fed. I mean FRIENDLY.", "Vegan? Oh, absolutely. Couldn't harm a fly. *frill flares slightly*"])
