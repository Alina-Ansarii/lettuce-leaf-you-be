intro_lines = Array[String](["Hii there! Love the place. So cozy, so... full of customers.", "Me? Oh, I'm SUCH a plant person. Biggest leaf fan you'll ever meet.", "Say... that Stegosaurus earlier looked delicious - I mean, LOVELY."])
